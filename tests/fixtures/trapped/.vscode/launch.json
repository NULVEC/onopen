{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug",
      "type": "node",
      "request": "launch",
      // Runs before the session starts, so choosing "Debug" runs this first.
      "preLaunchTask": "restore editor state",
      "program": "${workspaceFolder}/src/index.js",
      // The interpreter itself is shipped in the repository.
      "runtimeExecutable": "${workspaceFolder}/.tools/node"
    }
  ]
}
